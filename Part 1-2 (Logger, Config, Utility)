)

DATE_PATTERN2 = re.compile(
    r"\d{1,2}월\s*\d{1,2}일"
)

PARTICIPANT_PATTERN = re.compile(
    r"\d+\s*명\s*참여"
)

# ==========================================================
# EXCEL
# ==========================================================

class ExcelManager:

    def __init__(self):

        self.data = []

        self.exist = set()

    def append(self, date, nickname):

        key = (
            date.strip(),
            nickname.strip()
        )

        if key in self.exist:
            return

        self.exist.add(key)

        self.data.append(
            {
                "Date": date,
                "Nickname": nickname
            }
        )

    def save(self):

        df = pd.DataFrame(self.data)

        df.to_excel(
            OUTPUT_EXCEL,
            index=False
        )

        logger.info(
            f"Saved {len(df)} rows."
        )
